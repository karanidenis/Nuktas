# Database
DATABASE_URL=postgresql://postgres:postgres@localhost/nuktas_dev

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Server
PORT=4000
CLIENT_URL=http://localhost:5173
# Browser origin for the Docker/nginx UI. Override only if Compose is exposed
# on a different host or port; local npm development continues to use CLIENT_URL.
DOCKER_CLIENT_URL=http://localhost
NODE_ENV=development

# ASR (Python microservice — Kiswahili, default model Finiflowlabs/sauti-asr-v1)
ASR_BASE_URL=http://localhost:8010
# ASR_LANGUAGE=sw   # force source language; set empty to auto-detect

# TTS (Python microservice — Kiswahili). Engine: chatterbox (MIT, default) or mms (CC-BY-NC)
TTS_BASE_URL=http://localhost:8011
# TTS_ENGINE=chatterbox
# TTS_LANGUAGE=sw

# ── Nuktas agentic triage ────────────────────────────────────────────────────
# The MCP server is the only writer of triage/queue state. It reads this URL
# (falls back to DATABASE_URL) and the API spawns it over stdio.
MCP_DATABASE_URL=postgresql://postgres:postgres@localhost/nuktas_dev
# Optional overrides for how the API launches the MCP server:
# MCP_SERVER_CMD=node
# MCP_SERVER_ENTRY=./mcp-server/src/index.js
# The agent also reads its runtime policy through the official borrowed
# @modelcontextprotocol/server-filesystem package, restricted to ./protocols.
# BORROWED_MCP_ALLOWED_DIR=./protocols
# BORROWED_MCP_PROTOCOL_PATH=./protocols/TRIAGE_RUNTIME_POLICY.md

# Optional hosted MCP judge sandbox (synthetic data only)
# MCP_REMOTE_TOKEN=replace_with_a_long_random_token
# MCP_ALLOWED_HOSTS=mcp.example.org
# MCP_HTTP_PORT=8200
# MCP_RATE_LIMIT=120

# Agent worker (Python, Pydantic AI + local model). AGENT_SERVICE_TOKEN is shared
# between the API and the worker for the run-callback endpoints.
AGENT_BASE_URL=http://localhost:8100
AGENT_SERVICE_TOKEN=change_me_shared_service_token
AGENT_TIMEOUT_MS=15000
# Optional display-only estimate for the finalist metrics card. Set this to the
# blended USD cost per one million tokens for the configured model. Leave unset
# for local/self-hosted models; Nuktas then reports "Self-hosted" instead.
# MODEL_COST_PER_1M_TOKENS=0

# Shared LLM (OpenAI-compatible) — used by both server intake and the agent.
# Leave LLM_BASE_URL empty to use the bundled Ollama (the one-command demo).
# To point Docker *and* local dev at your own endpoint (e.g. a self-hosted
# vLLM/Qwen), set it here, e.g. LLM_BASE_URL=https://your-endpoint/v1
# For non-Docker dev an empty value falls back to http://localhost:11434/v1.
LLM_BASE_URL=
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen2.5:7b-instruct
# Disable thinking for Qwen3 short phone replies (set true if using a Qwen3
# thinking model that would otherwise consume the token budget).
# LLM_DISABLE_THINKING=true
# Optional in-country OpenAI-compatible embedding endpoint. When omitted,
# transcript search uses private PostgreSQL keyword matching and never falls
# back to a public provider.
# EMBED_BASE_URL=http://localhost:8080/v1
# EMBED_MODEL=nomic-embed-text
# EMBED_API_KEY=local
