{
  "name": "nuktas-server",
  "version": "1.0.0",
  "description": "Nuktas backend — Express + Socket.IO + PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "build": "echo 'No build step'",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:schema": "psql $DATABASE_URL -f db/schema.sql",
    "db:defaults": "psql $DATABASE_URL -f db/add_defaults.sql",
    "db:seed": "node db/seed.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.47.1",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "twilio": "^5.1.0",
    "uuid": "^9.0.1"
  }
}
